    {
      "description": "Copie une clé d’un compte OpenBao (`source`) vers un autre (`destination`), au même chemin ou à `cheminDestination`, sans que sa valeur passe en clair. Refuse d’écraser une clé existante, sauf `ecraser`.",
      "effect": "write",
      "examples": [
        {
          "input": {
            "chemin": "atom/portail/api",
            "cle": "DB_PASSWORD",
            "destination": "int",
            "source": "rec"
          },
          "name": "Mot de passe copié de la recette vers l’intégration",
          "output": {
            "chemin": "atom/portail/api",
            "cle": "DB_PASSWORD",
            "destination": "int",
            "version": 3
          }
        },
        {
          "input": {
            "chemin": "atom/portail/api",
            "cheminDestination": "atom/portail/api-pp",
            "cle": "JWT_SECRET",
            "destination": "preprod",
            "source": "prod"
          },
          "name": "Clé copiée à un autre chemin",
          "output": {
            "chemin": "atom/portail/api-pp",
            "cle": "JWT_SECRET",
            "destination": "preprod",
            "version": 1
          }
        }
      ],
      "id": "copier-cle",
      "input": {
        "properties": {
          "chemin": {
            "description": "Chemin du secret à la source.",
            "type": "string"
          },
          "cheminDestination": {
            "description": "Chemin à destination ; à défaut, le même.",
            "type": "string"
          },
          "cle": {
            "description": "Nom de la clé.",
            "type": "string"
          },
          "destination": {
            "description": "Compte d’arrivée (identifiant d’instance).",
            "type": "string"
          },
          "ecraser": {
            "description": "Remplacer la clé si elle existe déjà à destination.",
            "type": "boolean"
          },
          "source": {
            "description": "Compte de départ (identifiant d’instance).",
            "type": "string"
          }
        },
        "required": [
          "source",
          "destination",
          "chemin",
          "cle"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "chemin": {
            "type": "string"
          },
          "cle": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "destination",
          "chemin",
          "cle",
          "version"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "has": [
              "version"
            ]
          },
          "input": {
            "cle": "ALFRED_ESSAI",
            "destination": "dev",
            "ecraser": true,
            "source": "rec"
          },
          "name": "Copie la clé d’essai vers un autre compte",
          "target": {
            "field": "chemin",
            "label": "Secret de test présent dans les deux comptes (chemin)"
          }
        }
      ],
      "tool": false,
      "uses": {
        "clients": [
          "openbao"
        ]
      }
    },
