        "type": "object"
      },
      "output": {
        "properties": {
          "chemin": {
            "type": "string"
          },
          "cle": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "chemin",
          "cle",
          "version"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
