      "label": "Jenkins"
    }
  ],
  "description": "Tableau de bord des jobs Jenkins suivis : état en direct, logs et relance, en plusieurs vues.",
  "functions": [
    {
      "description": "Liste les comptes Jenkins reliés à l’espace (nom et identifiant, sans adresse ni secret).",
      "effect": "read",
      "examples": [
        {
          "input": {},
          "name": "Un compte Jenkins",
          "output": {
            "comptes": [
              {
                "default": true,
                "id": "equipe",
                "label": "Jenkins de l’équipe"
              }
            ]
          }
        },
        {
          "input": {
            "aucun": true
          },
          "name": "Aucun compte relié",
          "output": {
            "comptes": []
          }
        }
      ],
      "id": "comptes-jenkins",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "comptes": {
            "items": {
              "properties": {
                "default": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "default"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "comptes"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "has": [
              "comptes"
            ],
            "schema": true
          },
          "input": {},
          "name": "Liste les comptes Jenkins"
        }
      ],
      "tool": false,
      "uses": {
        "clients": [
          "jenkins"
