    {
      "description": "Cherche des jobs Jenkins par leur nom ou leur dossier, à n’importe quelle profondeur de dossiers, de dossiers d’organisation et de pipelines multibranches : trois niveaux par demande, puis chaque dossier du dernier niveau est relu (200 demandes au plus, gardées une minute).",
      "effect": "read",
      "examples": [
        {
          "input": {},
          "name": "Cinq jobs",
          "output": {
            "incomplet": false,
            "jobs": [
              {
                "chemin": "api-facturation/main",
                "dossier": "api-facturation",
                "etat": "blue",
                "nom": "main",
                "url": "https://jenkins.exemple.fr/job/api-facturation/job/main/"
              },
              {
                "chemin": "deploiement-prod",
                "dossier": "",
                "etat": "blue_anime",
                "nom": "deploiement-prod",
                "url": "https://jenkins.exemple.fr/job/deploiement-prod/"
              },
              {
                "chemin": "front-web",
                "dossier": "",
                "etat": "red",
                "nom": "front-web",
                "url": "https://jenkins.exemple.fr/job/front-web/"
              },
              {
                "chemin": "outils/migration-donnees",
                "dossier": "outils",
                "etat": "notbuilt",
                "nom": "migration-donnees",
                "url": "https://jenkins.exemple.fr/job/outils/job/migration-donnees/"
              },
              {
                "chemin": "qualite/tests-nocturnes",
                "dossier": "qualite",
                "etat": "yellow",
                "nom": "tests-nocturnes",
                "url": "https://jenkins.exemple.fr/job/qualite/job/tests-nocturnes/"
              }
            ],
            "total": 5
          }
        },
        {
          "input": {
            "texte": "factu"
          },
          "name": "Recherche « factu »",
          "output": {
            "incomplet": false,
            "jobs": [
              {
                "chemin": "api-facturation/main",
                "dossier": "api-facturation",
                "etat": "blue",
                "nom": "main",
                "url": "https://jenkins.exemple.fr/job/api-facturation/job/main/"
              }
            ],
            "total": 1
          }
        },
        {
          "input": {
            "texte": "zzz"
          },
          "name": "Aucun job trouvé",
          "output": {
            "incomplet": false,
            "jobs": [],
            "total": 0
          }
        }
      ],
      "id": "chercher-jobs",
      "input": {
        "properties": {
          "instance": {
            "description": "Compte Jenkins ; omis, celui par défaut.",
            "type": "string"
          },
          "limite": {
            "description": "Nombre de jobs rendus au plus (200 par défaut).",
            "type": "integer"
          },
          "simulation": {
            "description": "Réservé aux tests : cherche dans un faux Jenkins en mémoire (cinq niveaux de dossiers, un dossier refusé) au lieu du compte.",
            "type": "boolean"
          },
          "texte": {
            "description": "Mots cherchés dans le nom complet du job ; vide, tous les jobs.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "incomplet": {
            "description": "Vrai si des dossiers n’ont pas pu être lus (droits, erreur) ou si la limite de demandes a arrêté le parcours.",
            "type": "boolean"
          },
          "jobs": {
            "items": {
              "properties": {
                "chemin": {
                  "description": "Nom complet, dossiers compris : api-facturation/main.",
                  "type": "string"
                },
                "dossier": {
                  "type": "string"
                },
                "etat": {
                  "description": "Couleur Jenkins : blue, red, yellow, aborted, notbuilt, disabled, suivie de _anime pendant un build.",
                  "type": "string"
                },
                "nom": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "chemin",
                "nom",
                "dossier",
                "etat",
                "url"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "jobs",
          "total"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "has": [
              "jobs",
              "total"
            ],
            "schema": true
          },
          "input": {},
          "name": "Liste les jobs du compte"
        },
        {
          "expect": {
            "equals": {
              "jobs.0.chemin": "plateforme/equipes/paiement/services/api-paiement",
              "jobs.0.dossier": "plateforme / equipes / paiement / services",
              "total": 1
            },
            "schema": true
          },
          "input": {
            "simulation": true,
            "texte": "api paiement"
          },
          "name": "Trouve un job à quatre niveaux de dossiers (faux Jenkins)"
        },
        {
          "expect": {
            "equals": {
              "jobs.0.chemin": "plateforme/equipes/paiement/services/batch/rapprochement-nocturne",
              "jobs.0.nom": "rapprochement-nocturne",
              "total": 1
            },
            "schema": true
          },
          "input": {
            "simulation": true,
            "texte": "rapprochement"
          },
          "name": "Trouve un job à cinq niveaux de dossiers (faux Jenkins)"
        },
        {
          "expect": {
            "equals": {
              "jobs.0.chemin": "github-acme/facturation/feature%2Fexport-pdf",
              "jobs.0.nom": "feature/export-pdf",
              "jobs.1.chemin": "github-acme/facturation/main",
              "total": 2
            },
            "schema": true
          },
          "input": {
            "simulation": true,
            "texte": "facturation"
          },
          "name": "Parcourt un dossier d’organisation et son pipeline multibranche (faux Jenkins)"
        },
        {
          "expect": {
            "equals": {
              "incomplet": true,
              "jobs.0.chemin": "front-web",
              "total": 6
            },
            "schema": true
          },
          "input": {
            "simulation": true
          },
          "name": "Trouve tous les jobs et signale le dossier refusé (faux Jenkins)"
        }
      ],
      "tool": false,
      "uses": {
        "clients": [
          "jenkins"
        ]
      }
    },
