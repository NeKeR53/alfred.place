{
  "clients": [
    {
      "client": {
        "headers": {
          "Accept": "application/json"
        },
        "label": "Portainer",
        "methods": [
          {
            "help": "Votre identifiant Portainer. Je me connecte pour vous et renouvelle la session.",
            "id": "identifiant",
            "label": "Identifiant et mot de passe",
            "login": {
              "body": {
                "password": "{password}",
                "username": "{username}"
              },
              "path": "/api/auth",
              "token": "jwt"
            },
            "params": [
              {
                "default": "1",
                "example": "1",
                "help": "Le numéro de l’environnement (endpoint) dans Portainer : il figure dans l’adresse de son tableau de bord (#!/<numéro>/docker/dashboard).",
                "id": "endpoint",
                "label": "Environnement Portainer"
              }
            ],
            "type": "session",
            "urlExample": "https://portainer.recette.exemple.fr"
          },
          {
            "header": "X-API-Key",
            "help": "Dans Portainer : votre compte (en haut à droite), Clés d’accès, Ajouter une clé.",
            "id": "cle",
            "label": "Clé d’accès Portainer",
            "params": [
              {
                "default": "1",
                "example": "1",
                "help": "Le numéro de l’environnement (endpoint) dans Portainer : il figure dans l’adresse de son tableau de bord (#!/<numéro>/docker/dashboard).",
                "id": "endpoint",
                "label": "Environnement Portainer"
              }
            ],
            "type": "apiKey",
            "urlExample": "https://portainer.recette.exemple.fr"
          }
        ],
        "testPath": "/api/endpoints"
      },
      "help": "Un compte par environnement : l’adresse du Portainer, votre identifiant (ou une clé d’accès) et le numéro de l’environnement Docker à suivre.",
      "id": "portainer",
      "label": "Portainer"
    }
  ],
  "description": "Connecteur Portainer : piles, conteneurs, journaux en direct et console d’un environnement Docker, un compte par environnement.",
  "functions": [
    {
      "description": "Comptes Portainer reliés à l’espace (identifiant, nom, compte par défaut), sans adresse ni secret. `probleme` dit pourquoi la liste est vide quand le service n’est pas encore configuré.",
      "effect": "read",
      "examples": [
        {
          "input": {},
          "name": "Les six comptes, un par environnement",
          "output": {
            "comptes": [
              {
                "default": true,
                "id": "dev",
                "label": "Portainer Développement"
              },
              {
                "default": false,
                "id": "int",
                "label": "Portainer Intégration"
              },
              {
                "default": false,
                "id": "rec",
                "label": "Portainer Recette"
              },
              {
                "default": false,
                "id": "val",
                "label": "Portainer Validation"
              },
              {
                "default": false,
                "id": "preprod",
                "label": "Portainer Préproduction"
              },
              {
                "default": false,
                "id": "prod",
                "label": "Portainer Production"
              }
            ]
          }
        },
        {
          "input": {
            "aucun": true
          },
          "name": "Aucun compte encore relié",
          "output": {
            "comptes": [],
            "probleme": "Le service Portainer n’a encore aucun compte."
          }
        }
      ],
      "id": "lister-comptes",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "comptes": {
            "items": {
              "properties": {
                "default": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "default"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "probleme": {
            "description": "Raison d’une liste vide (service pas encore configuré).",
            "type": "string"
          }
        },
        "required": [
          "comptes"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "has": [
              "comptes"
            ],
            "schema": true
          },
          "input": {},
          "name": "Liste les comptes Portainer"
        }
      ],
      "tool": false,
      "uses": {
        "clients": [
          "portainer"
        ]
      }
    },
