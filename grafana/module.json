{
  "clients": [
    {
      "client": {
        "headers": {
          "Accept": "application/json"
        },
        "label": "Grafana",
        "methods": [
          {
            "help": "Dans Grafana : Administration, Comptes de service, Ajouter un compte de service (rôle Admin), puis Ajouter un jeton. Copiez-le tout de suite.",
            "id": "jeton",
            "label": "Jeton de compte de service",
            "tokenPage": "{url}/org/serviceaccounts",
            "type": "bearer",
            "urlExample": "https://grafana.recette.exemple.fr"
          },
          {
            "help": "Un compte local de Grafana (pas une connexion par SSO), administrateur de l’organisation.",
            "id": "identifiant",
            "label": "Identifiant et mot de passe",
            "type": "basic",
            "urlExample": "https://grafana.recette.exemple.fr"
          }
        ],
        "testPath": "/api/org"
      },
      "help": "Un compte par environnement : l’adresse du Grafana et, de préférence, un jeton de compte de service avec le rôle Admin de l’organisation.",
      "id": "grafana",
      "label": "Grafana"
    }
  ],
  "description": "Connecteur Grafana : équipes, comptes et droits sur les dossiers de tableaux de bord, un compte par environnement.",
  "functions": [
    {
      "description": "Comptes Grafana reliés à l’espace (identifiant, nom, compte par défaut), sans adresse ni secret. `probleme` dit pourquoi la liste est vide quand le service n’est pas encore configuré.",
      "effect": "read",
      "examples": [
        {
          "input": {},
          "name": "Les six comptes, un par environnement",
          "output": {
            "comptes": [
              {
                "default": true,
                "id": "dev",
                "label": "Grafana Développement"
              },
              {
                "default": false,
                "id": "int",
                "label": "Grafana Intégration"
              },
              {
                "default": false,
                "id": "rec",
                "label": "Grafana Recette"
              },
              {
                "default": false,
                "id": "val",
                "label": "Grafana Validation"
              },
              {
                "default": false,
                "id": "preprod",
                "label": "Grafana Préproduction"
              },
              {
                "default": false,
                "id": "prod",
                "label": "Grafana Production"
              }
            ]
          }
        },
        {
          "input": {
            "aucun": true
          },
          "name": "Aucun compte encore relié",
          "output": {
            "comptes": [],
            "probleme": "Le service Grafana n’a encore aucun compte."
          }
        }
      ],
      "id": "lister-comptes",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "comptes": {
            "items": {
              "properties": {
                "default": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "default"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "probleme": {
            "description": "Raison d’une liste vide (service pas encore configuré).",
            "type": "string"
          }
        },
        "required": [
          "comptes"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "has": [
              "comptes"
            ],
            "schema": true
          },
          "input": {},
          "name": "Liste les comptes Grafana"
        }
      ],
      "tool": false,
      "uses": {
        "clients": [
          "grafana"
        ]
      }
