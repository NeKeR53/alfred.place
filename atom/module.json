{
  "description": "Socle d’Atom : les environnements (développement, intégration, recette, validation, préproduction, production) et le compte Keycloak, Grafana, OpenBao et Portainer de chacun.",
  "functions": [
    {
      "description": "Environnements d’Atom dans leur ordre (nom, code, nature, couleur) avec, pour chacun, l’identifiant du compte Keycloak, Grafana, OpenBao et Portainer à utiliser (null s’il n’est pas choisi). `environnement` (identifiant ou code) n’en garde qu’un.",
      "effect": "read",
      "examples": [
        {
          "input": {},
          "name": "Six environnements, la recette rattachée",
          "output": {
            "environnements": [
              {
                "code": "DEV",
                "couleur": "steel",
                "id": "dev",
                "instances": {
                  "grafana": null,
                  "keycloak": null,
                  "openbao": null,
                  "portainer": null
                },
                "nature": "developpement",
                "nom": "Développement",
                "ordre": 1
              },
              {
                "code": "INT",
                "couleur": "blue",
                "id": "int",
                "instances": {
                  "grafana": null,
                  "keycloak": null,
                  "openbao": null,
                  "portainer": null
                },
                "nature": "integration",
                "nom": "Intégration",
                "ordre": 2
              },
              {
                "code": "REC",
                "couleur": "violet",
                "id": "rec",
                "instances": {
                  "grafana": "rec",
                  "keycloak": "rec",
                  "openbao": "rec",
                  "portainer": "rec"
                },
                "nature": "recette",
                "nom": "Recette",
                "ordre": 3
              },
              {
                "code": "VAL",
                "couleur": "teal",
                "id": "val",
                "instances": {
                  "grafana": null,
                  "keycloak": null,
                  "openbao": null,
                  "portainer": null
                },
                "nature": "validation",
                "nom": "Validation",
                "ordre": 4
              },
              {
                "code": "PPROD",
                "couleur": "orange",
                "id": "preprod",
                "instances": {
                  "grafana": null,
                  "keycloak": null,
                  "openbao": null,
                  "portainer": null
                },
                "nature": "preproduction",
                "nom": "Préproduction",
                "ordre": 5
              },
              {
                "code": "PROD",
                "couleur": "red",
                "id": "prod",
                "instances": {
                  "grafana": "prod",
                  "keycloak": "prod",
                  "openbao": "prod",
                  "portainer": "prod"
                },
                "nature": "production",
                "nom": "Production",
                "ordre": 6
              }
            ]
          }
        },
        {
          "input": {
            "environnement": "rec"
          },
          "name": "La recette seule",
          "output": {
            "environnements": [
              {
                "code": "REC",
                "couleur": "violet",
                "id": "rec",
                "instances": {
                  "grafana": "rec",
                  "keycloak": "rec",
                  "openbao": "rec",
                  "portainer": "rec"
                },
                "nature": "recette",
                "nom": "Recette",
                "ordre": 3
              }
            ]
          }
        }
      ],
      "id": "lister-environnements",
      "input": {
        "properties": {
          "environnement": {
            "description": "Identifiant ou code d’un environnement (rec, REC).",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "environnements": {
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "couleur": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "instances": {
                  "properties": {
                    "grafana": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "keycloak": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "openbao": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "portainer": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "keycloak",
                    "grafana",
                    "openbao",
                    "portainer"
                  ],
                  "type": "object"
                },
                "nature": {
                  "type": "string"
                },
                "nom": {
                  "type": "string"
                },
                "ordre": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "nom",
                "code",
                "nature",
                "ordre",
                "instances"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "environnements"
        ],
        "type": "object"
      },
      "tests": [
        {
          "expect": {
            "equals": {
              "environnements.0.code": "DEV"
            },
            "nonEmpty": [
              "environnements"
            ]
          },
          "input": {},
          "name": "Liste les six environnements"
        },
        {
          "expect": {
            "equals": {
              "environnements.0.id": "rec"
            }
          },
          "input": {
            "environnement": "REC"
          },
          "name": "Retrouve la recette par son code"
        }
      ],
      "tool": true
    }
  ],
  "id": "atom",
